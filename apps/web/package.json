{
  "name": "@gestarahub/web",
  "version": "2026.11.26",
  "private": true,
  "sideEffects": [
    "*.css",
    "./src/instrumentation.ts",
    "./src/instrumentation-client.ts",
    "./src/lib/zod-config.ts",
    "./src/lib/log/server-sink.ts",
    "./src/lib/documents/*.tsx",
    "./src/mocks/helpers.ts",
    "./src/mocks/store.ts",
    "./src/services/world/scope.ts",
    "./src/services/personDocuments/personDocumentFiles.ts",
    "./src/services/communication/messageDelivery.ts",
    "./src/services/communication/whatsappCredentials.ts"
  ],
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=2048' next dev -p 3200",
    "dev:https": "NODE_OPTIONS='--max-old-space-size=2048' next dev -p 3200 --experimental-https",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:roundtrip": "vitest run --config vitest.roundtrip.config.ts",
    "world:schema": "node scripts/gen-world-schema.mjs",
    "icons:build": "node scripts/gen-app-icons.mjs",
    "demo:seed": "vitest run --config vitest.seed.config.ts",
    "demo:local": "node scripts/dev-demo.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:smoke": "playwright test --project=desktop --grep @smoke",
    "e2e:area": "node scripts/e2e-area.mjs",
    "e2e:prod": "E2E_SERVER=prod playwright test",
    "help:build": "node scripts/build-help-kb.mjs",
    "qa:roteiro": "node scripts/build-qa-roteiro.mjs"
  },
  "dependencies": {
    "@gestarahub/contracts": "workspace:*",
    "@gestarahub/core": "workspace:*",
    "@hookform/resolvers": "^5.4.0",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.101.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "jsqr": "1.4.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.438.12",
    "qrcode": "1.5.4",
    "qrcode.react": "4.2.0",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "postgres": "^3.4.9",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
