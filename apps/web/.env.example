# Supabase (local dev: `pnpm supabase:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# URL base da aplicação (para montar links enviados por e-mail)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MailerSend (envio transacional do link de cadastro 24h)
MAILERSEND_API_KEY=mlsn.your_mailersend_api_key
MAILERSEND_FROM_EMAIL=naoresponda@gestarahub.com.br
MAILERSEND_FROM_NAME=GestaraHub

# Asaas (Ambiente de Testes / Sandbox)
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
# A chave do Asaas comeca com "$aact_". O Next expande "$NOME" nos arquivos .env,
# entao escape o cifrao com barra invertida e nao use aspas: ASAAS_API_KEY=\$aact_...
ASAAS_API_KEY=\$aact_COLE_SUA_CHAVE_AQUI
ASAAS_MASTER_WALLET_ID=seu_wallet_id_master
# Webhook de baixa automatica, cadastrado em cada subconta (doc 19, secao 4).
# URL publica da rota app/api/webhooks/asaas. Local: a do tunel
# (cloudflared tunnel --url http://localhost:3000) + /api/webhooks/asaas.
# Ao trocar a URL, as subcontas sao recadastradas sozinhas no proximo acesso.
ASAAS_WEBHOOK_URL=https://SEU_ENDERECO_PUBLICO/api/webhooks/asaas
# Token que o Asaas devolve no cabecalho asaas-access-token. Gere um aleatorio
# (32+ caracteres, sem espacos e diferente da chave de API).
ASAAS_WEBHOOK_SECRET=GERE_UM_TOKEN_ALEATORIO
# E-mail que o Asaas avisa se o webhook falhar (obrigatorio no Asaas). Vazio:
# usa o e-mail da conta principal.
ASAAS_WEBHOOK_EMAIL=

# WhatsApp Business Platform (Meta Cloud API)
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_API_TOKEN=COLE_SEU_ACCESS_TOKEN_AQUI
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=seu_business_account_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=gestarahub_whatsapp_verify_token
