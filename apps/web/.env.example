# Supabase (local dev: `pnpm setup:local` preenche automaticamente)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URLs base da aplicacao e segredo de sessao
NEXT_PUBLIC_APP_URL=http://localhost:3200
NEXT_PUBLIC_SITE_URL=http://localhost:3200
# Recomendado em producao (32+ caracteres aleatorios). Vazio em local: deriva da service role.
SESSION_SECRET=

# Amazon SES (envio transacional via API v2 / IAM)
AWS_SES_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM_ADDRESS=naoresponda@gestarahub.com.br
EMAIL_FROM_NAME=GestaraHub
# Caixa que recebe as respostas (boas-vindas: "Responda este e-mail").
EMAIL_REPLY_TO=contato@gestarahub.com.br

# Asaas (Ambiente de Testes / Sandbox)
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
# A chave do Asaas comeca com "$aact_". O Next expande "$NOME" nos arquivos .env,
# entao escape o cifrao com barra invertida e nao use aspas: ASAAS_API_KEY=\$aact_...
ASAAS_API_KEY=
ASAAS_MASTER_WALLET_ID=
# Webhook de baixa automatica, cadastrado em cada subconta (doc product/19, secao 4).
# URL publica da rota app/api/webhooks/asaas (`pnpm tunnel` gera em dev).
ASAAS_WEBHOOK_URL=
# Token que o Asaas devolve no cabecalho asaas-access-token (32+ caracteres aleatorios).
ASAAS_WEBHOOK_SECRET=
# E-mail que o Asaas avisa se o webhook falhar (obrigatorio em producao).
ASAAS_WEBHOOK_EMAIL=

# WhatsApp Business Platform (Meta Cloud API)
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Segredo do app na Meta (obrigatorio em producao para validar assinatura do webhook).
META_APP_SECRET=
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=

# Supabase Cron -> rotas /api/cron/* (geracao diaria das mensalidades, doc archive/technical-15).
# Mesmo valor do segredo `cron_secret` no Vault do Supabase. Local: `pnpm cron:local`.
CRON_SECRET=

# Senha dos usuarios da demonstracao (Academia X). So no ambiente local (`pnpm demo:local`).
# Nunca definir em producao.
DEMO_PASSWORD=

# PostHog (analise de uso na landing e no app, com aviso de cookies LGPD).
# Sem a chave, o PostHog nao carrega e o aviso de cookies nao aparece.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Entrar com Google (doc guides/16). Liga o botao "Continuar com Google";
# as chaves do Google ficam no Supabase (local: apps/supabase/.env).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=

# Resumo diario dos erros e alerta na hora (doc technical/21 e technical/27). Vazio = nao envia.
ERROR_DIGEST_EMAIL=

# Assistente de Suporte por IA (doc technical/26, secao 6.5). Opcional.
# Sem a chave o assistente fica desligado e o suporte segue direto para atendimento humano.
ANTHROPIC_API_KEY=
SUPPORT_BOT_MODEL=claude-haiku-5-5

# Opcional: limite de linhas no cache em memoria por instancia (padrao 150000).
WORLD_CACHE_MAX_ROWS=
