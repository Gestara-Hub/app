# Painel admin do GestaraHub (apps/admin). O `pnpm admin:setup` preenche o local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Conexao direta de servidor, com o papel `platform_app` (nunca a chave service_role)
PLATFORM_DATABASE_URL=
# Segredo que assina o cookie do tempo de sessao (32+ caracteres aleatorios)
ADMIN_SESSION_SECRET=
# local | staging | production (cor da faixa do topo)
ADMIN_ENV_LABEL=local

# Segredo da rotina diaria (GET /api/cron/digest, Authorization: Bearer ...)
CRON_SECRET=
# Convite de administradores e reinicio do 2FA (so o modulo lib/server/auth-admin usa; sem ela o convite fica desligado)
ADMIN_SERVICE_ROLE_KEY=

# E-mail (Amazon SES): respostas do suporte e rotina diaria. Sem as chaves, so registra no log.
AWS_SES_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM_ADDRESS=naoresponda@gestarahub.com.br
EMAIL_FROM_NAME=GestaraHub

# Opcionais
# Endereco do app dos clientes (link nos e-mails de resposta)
WEB_APP_URL=http://localhost:3200
# Endereco publico deste painel (link do convite)
ADMIN_PUBLIC_URL=http://localhost:3201
# Quem recebe o resumo diario do suporte
ADMIN_NOTIFY_EMAIL=
