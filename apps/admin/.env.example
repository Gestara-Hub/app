# Painel admin do GestaraHub (apps/admin). O `pnpm admin:setup` preenche o local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Conexao direta de servidor, com o papel `platform_app` (nunca a chave service_role)
PLATFORM_DATABASE_URL=
# Segredo que assina o cookie do tempo de sessao (32+ caracteres)
ADMIN_SESSION_SECRET=
# local | staging | production (cor da faixa do topo)
ADMIN_ENV_LABEL=local
