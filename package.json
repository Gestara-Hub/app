{
  "name": "gestarahub",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @gestarahub/web dev",
    "dev:https": "pnpm --filter @gestarahub/web dev:https",
    "tunnel": "node apps/web/scripts/dev-tunnel.mjs",
    "setup:local": "node apps/web/scripts/local-setup.mjs",
    "setup:local:reset": "node apps/web/scripts/local-setup.mjs --reset",
    "cron:local": "node apps/web/scripts/dev-cron-secrets.mjs",
    "demo:local": "node apps/web/scripts/dev-demo.mjs",
    "build": "pnpm --filter @gestarahub/web build",
    "lint": "pnpm --filter @gestarahub/web lint",
    "typecheck": "pnpm --filter @gestarahub/web typecheck",
    "test": "pnpm --filter @gestarahub/core test && pnpm --filter @gestarahub/web test && pnpm --filter @gestarahub/admin test",
    "e2e": "pnpm --filter @gestarahub/web e2e",
    "supabase:start": "supabase start --workdir apps",
    "supabase:stop": "supabase stop --workdir apps",
    "supabase:status": "supabase status --workdir apps",
    "supabase:reset": "supabase db reset --workdir apps",
    "supabase:functions": "supabase functions serve --workdir apps --import-map apps/supabase/functions/deno.json",
    "dev:admin": "pnpm --filter @gestarahub/admin dev",
    "admin:setup": "pnpm --filter @gestarahub/admin setup:local",
    "admin:create-admin": "pnpm --filter @gestarahub/admin create-admin",
    "admin:reset-mfa": "pnpm --filter @gestarahub/admin reset-mfa",
    "lint:admin": "pnpm --filter @gestarahub/admin lint",
    "typecheck:admin": "pnpm --filter @gestarahub/admin typecheck",
    "agents:sync": "cp AGENTS.md .agents/AGENTS.md && rsync -a --delete .claude/skills/ .agents/skills/"
  }
}
