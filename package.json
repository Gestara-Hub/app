{
  "name": "gestarahub",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @gestarahub/web dev",
    "build": "pnpm --filter @gestarahub/web build",
    "lint": "pnpm --filter @gestarahub/web lint",
    "typecheck": "pnpm --filter @gestarahub/web typecheck",
    "test": "pnpm --filter @gestarahub/core test && pnpm --filter @gestarahub/web test",
    "e2e": "pnpm --filter @gestarahub/web e2e"
  }
}
