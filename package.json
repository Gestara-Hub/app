{
  "name": "gestarahub",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @gestarahub/web dev",
    "tunnel": "node apps/web/scripts/dev-tunnel.mjs",
    "cron:local": "node apps/web/scripts/dev-cron-secrets.mjs",
    "build": "pnpm --filter @gestarahub/web build",
    "lint": "pnpm --filter @gestarahub/web lint",
    "typecheck": "pnpm --filter @gestarahub/web typecheck",
    "test": "pnpm --filter @gestarahub/core test && pnpm --filter @gestarahub/web test",
    "e2e": "pnpm --filter @gestarahub/web e2e",
    "supabase:start": "supabase start --workdir apps",
    "supabase:stop": "supabase stop --workdir apps",
    "supabase:status": "supabase status --workdir apps",
    "supabase:reset": "supabase db reset --workdir apps",
    "supabase:functions": "supabase functions serve --workdir apps --import-map apps/supabase/functions/deno.json"
  }
}
